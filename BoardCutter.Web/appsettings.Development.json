{
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "vite-src": {
        "ClusterId": "vite-dev",
        "Match": {
          "Path": "/src/{**catch-all}"
        }
      },
      "vite-hmr": {
        "ClusterId": "vite-dev",
        "Match": {
          "Path": "/@vite/{**catch-all}"
        }
      },
      "vite-fs": {
        "ClusterId": "vite-dev",
        "Match": {
          "Path": "/@fs/{**catch-all}"
        }
      },
      "vite-node-modules": {
        "ClusterId": "vite-dev",
        "Match": {
          "Path": "/node_modules/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "vite-dev": {
        "Destinations": {
          "vite": {
            "Address": "http://localhost:5173"
          }
        }
      }
    }
  }
}
